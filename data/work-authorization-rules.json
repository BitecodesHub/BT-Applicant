  "sponsorshipSignals": [
    {
      "id": "offered.available",
      "signal": "sponsorship_offered",
      "pattern": "visa sponsorship (?:is )?(?:available|provided|offered)"
    },
    {
      "id": "offered.short",
      "signal": "sponsorship_offered",
      "pattern": "sponsorship (?:is )?(?:available|provided|offered)"
    },
    {
      "id": "offered.we-sponsor",
      "signal": "sponsorship_offered",
      "pattern": "(?:we|company|employer) (?:do|will|can|are happy to|are willing to) sponsor"
    },
    {
      "id": "offered.willing",
      "signal": "sponsorship_offered",
      "pattern": "(?:able|happy|willing|ready) to (?:provide |offer )?(?:visa )?sponsor(?:ship)?"
    },
    {
      "id": "offered.work-permit",
      "signal": "sponsorship_offered",
      "pattern": "work permit (?:support|assistance|sponsorship)"
    },
    {
      "id": "offered.we-sponsor-visas",
      "signal": "sponsorship_offered",
      "pattern": "we sponsor (?:work )?visas"
    },
    {
      "id": "not-offered.unable",
      "signal": "sponsorship_not_offered",
      "pattern": "(?:we are |we're |we )?(?:not able|unable) to (?:provide |offer )?(?:visa )?sponsor"
    },
    {
      "id": "not-offered.do-not",
      "signal": "sponsorship_not_offered",
      "pattern": "(?:do|does) not (?:provide |offer )?(?:visa )?sponsorship"
    },
    {
      "id": "not-offered.no",
      "signal": "sponsorship_not_offered",
      "pattern": "no (?:visa )?sponsorship"
    },
    {
      "id": "not-offered.not-available",
      "signal": "sponsorship_not_offered",
      "pattern": "sponsorship (?:is )?not (?:available|offered|provided)"
    },
    {
      "id": "not-offered.without",
      "signal": "sponsorship_not_offered",
      "pattern": "without (?:visa )?sponsorship"
    },
    {
      "id": "not-offered.cannot",
      "signal": "sponsorship_not_offered",
      "pattern": "(?:cannot|can't|won't) sponsor"
    },
    {
      "id": "rtw.must-have",
      "signal": "existing_right_to_work_required",
      "pattern": "(?:must|need to|required to|should) (?:already )?(?:have|possess) (?:the )?(?:legal )?right to work"
    },
    {
      "id": "rtw.in-country",
      "signal": "existing_right_to_work_required",
      "pattern": "right to work in (?:the )?(?:uk|united kingdom|us|usa|united states|eu|europe|ireland|canada|australia|germany|netherlands|france|spain|portugal|sweden|denmark|norway|finland|switzerland|singapore|japan|uae)"
    },
    {
      "id": "rtw.authorized",
      "signal": "existing_right_to_work_required",
      "pattern": "(?:must be|are) (?:legally )?(?:authorized|eligible) to work"
    },
    {
      "id": "rtw.no-visa-support",
      "signal": "existing_right_to_work_required",
      "pattern": "no visa support"
    },
    {
      "id": "rtw.valid-permit",
      "signal": "existing_right_to_work_required",
      "pattern": "must have (?:a )?valid work permit"
    },
    {
      "id": "rtw.existing",
      "signal": "existing_right_to_work_required",
      "pattern": "existing (?:right to work|work authori[sz]ation)"
    },
    {
      "id": "citizenship.only",
      "signal": "citizenship_or_clearance_required",
      "pattern": "(?:us|u\\.s\\.|united states|uk|british|eu|european|australian|canadian|irish) (?:citizens?|citizenship) only"
    },
    {
      "id": "citizenship.must-be",
      "signal": "citizenship_or_clearance_required",
      "pattern": "must be (?:a )?(?:us|u\\.s\\.|uk|british|eu|european|australian|canadian|irish) citizen"
    },
    {
      "id": "clearance.required",
      "signal": "citizenship_or_clearance_required",
      "pattern": "(?:active|current|valid|obtain|hold) (?:security )?clearance"
    },
    {
      "id": "clearance.sc",
      "signal": "citizenship_or_clearance_required",
      "pattern": "(?:sc|dv|nv|ts|top secret) cleared"
    },
    {
      "id": "clearance.generic",
      "signal": "citizenship_or_clearance_required",
